# ==============================================================================
# Production & Deployment Environment Variables Template
# Store Rating Management System (Bangalore Edition)
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Option A: Discrete Credentials)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_mysql_password
DB_NAME=store_rating_db
DB_PORT=3306
DB_SSL=false
DB_CONNECTION_LIMIT=15

# Database Configuration (Option B: Full Cloud Connection String / PaaS)
# DATABASE_URL=mysql://user:password@host:port/store_rating_db

# Security & Authentication (JWT)
JWT_SECRET=replace_this_with_a_cryptographically_secure_random_key_min_32_chars
JWT_EXPIRES_IN=24h

# Frontend & CORS Configuration
# Set to your production frontend domain (e.g. https://mystorerating.com)
# Or leave empty / '*' if served monolithically from the same Express instance
FRONTEND_URL=http://localhost:5173
